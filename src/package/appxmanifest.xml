  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.3775" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
