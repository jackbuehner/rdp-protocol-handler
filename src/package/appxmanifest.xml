        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="tsresource">
            <uap:Logo>images/Logo150x150.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.resource</uap:FileType>
              <uap:FileType>.tsresource</uap:FileType>
            </uap:SupportedFileTypes>
